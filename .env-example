# Copie este archivo a .env para usar valores propios: cp .env-example .env
# Si no existe .env, docker compose usa las credenciales de DEMOSTRACIÓN indicadas abajo
# (solo para desarrollo local; en cualquier otro entorno defina las suyas).
# Si JWT_SECRET queda vacío, se genera uno aleatorio y los tokens se invalidan al reiniciar.

# Genere uno con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

USUARIO_LECTURA=lector
CLAVE_LECTURA=lector123
USUARIO_ESCRITURA=operador
CLAVE_ESCRITURA=operador123
